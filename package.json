{
  "name": "syhr.sh",
  "version": "2.0.0",
  "private": true,
  "description": "A simple web tool for creating short, memorable and shareable links.",
  "license": "MIT",
  "author": "Rhys Bishop <mail@rhysbi.shop>",
  "repository": "github:ssyyhhrr/syhr.sh",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit && npm run test:e2e",
    "test": "npm run check",
    "start": "node src/server/main.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tests/e2e/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:legacy": "node scripts/e2e-legacy.ts",
    "fixtures:legacy": "node scripts/fixtures/record-legacy.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.9"
  }
}
